    },
    {
      "parameters": {
        "mode": "chooseBranch",
        "numberInputs": 4
      },
      "id": "b0863c6f-a81c-4e93-8f68-4a99ca01b24a",
      "name": "Wait All",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = n => { try { return $(n).all().map(i => i.json).filter(j => Object.keys(j).length); } catch { return []; } };\nconst breaches = rows('Mark SLA Breaches'), queue = rows('Review Queue > SLA'), cov = rows('Coverage');\nconst erased = (rows('GDPR Purge')[0] || {}).erased || 0;\nconst t = (list, cols) => list.length ? `<table border=1 cellpadding=4 style=\"border-collapse:collapse\">` +\n  `<tr>${cols.map(c => `<th>${c}</th>`).join('')}</tr>` + list.map(r => `<tr>${cols.map(c => `<td>${r[c] ?? ''}</td>`).join('')}</tr>`).join('') + '</table>' : '<p>None ✅</p>';\nconst html = `<h2>Legal network – daily governance</h2>\n<h3>Referral SLA breaches (${breaches.length})</h3>${t(breaches, ['candidate_ref','country_iso2','route_code'])}\n<h3>Verification queue over SLA / re-verification due (${queue.length})</h3>${t(queue, ['public_ref','full_name','country_iso2','bar_number','verification','hours'])}\n<h3>Coverage – priority markets</h3>${t(cov, ['iso2','name','lawyers_total','lawyers_verified','routes_covered','routes_total'])}\n<p>GDPR: ${erased} unanswered public-register record(s) erased (30-day rule).</p>`;\nreturn [{ json: { html, alert: breaches.length + queue.length > 0 } }];"
      },
      "id": "55cbd7c1-b3d8-4b78-b7cd-bc3462b20585",
      "name": "Build Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
