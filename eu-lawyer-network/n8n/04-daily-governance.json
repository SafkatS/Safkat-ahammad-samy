      "position": [
        440,
        640
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Supabase Postgres (lawnet)"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "authentication": "none",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "da11ac94-e9cb-4f98-a1de-dc9f422e50ed",
      "name": "Ping URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        640
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const src = $('URLs To Check').all();\nreturn $input.all().map((it, i) => ({ json: { kind: src[i].json.kind, id: src[i].json.id, url: src[i].json.url,\n  status: it.json.statusCode || (it.json.error ? 0 : 200) } }));"
      },
      "id": "b782f337-f24b-43d4-9f20-9190e8203ffa",
      "name": "URL Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        640
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update lawnet.bar_authorities set url_last_status = $3::int, url_verified_at = case when $3::int between 200 and 399 then now() else url_verified_at end where $1 = 'bar' and id = $2::uuid;\nupdate lawnet.permit_authorities set url_last_status = $3::int, url_verified_at = case when $3::int between 200 and 399 then now() else url_verified_at end where $1 = 'permit' and id = $2::uuid;",
        "options": {
          "queryReplacement": "={{ [$json.kind, $json.id, $json.status] }}"
        }
      },
      "id": "564938e8-5148-4263-b75e-96fc9c7edeed",
      "name": "Save URL Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1100,
        640
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Supabase Postgres (lawnet)"
        }
