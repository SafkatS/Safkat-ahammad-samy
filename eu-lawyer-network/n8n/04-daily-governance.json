        "fromEmail": "={{ $('Config').first().json.cfg.fromEmail }}",
        "toEmail": "={{ $('Config').first().json.cfg.opsEmail + ',' + $('Config').first().json.cfg.complianceEmail }}",
        "subject": "={{ ($json.alert ? '⚠ ' : '✅ ') + 'Legal network daily report ' + $now.toFormat('yyyy-LL-dd') }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "c3e3937d-0ab9-4cbc-9a34-12e9565106db",
