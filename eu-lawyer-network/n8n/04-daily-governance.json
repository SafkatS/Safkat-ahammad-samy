    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select 'bar' as kind, id, coalesce(register_search_url, website) as url from lawnet.bar_authorities where coalesce(register_search_url, website) is not null\nunion all select 'permit', id, website from lawnet.permit_authorities where website is not null;",
        "options": {}
      },
      "id": "50c1fd76-746e-4e4b-abe5-43f0e42cd3bf",
      "name": "URLs To Check",
      "type": "n8n-nodes-base.postgres",
