      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update lawnet.engagements set status = 'sla_breached'\nwhere status in ('proposed','lawyer_notified') and sla_due_at < now()\nreturning id, candidate_ref, country_iso2, route_code, lawyer_id;",
        "options": {}
      },
      "id": "74c25995-731e-40d3-a9e3-df232fbf5a63",
      "name": "Mark SLA Breaches",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Supabase Postgres (lawnet)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select public_ref, full_name, country_iso2, bar_number, verification, round(extract(epoch from waiting)/3600) as hours from lawnet.v_verification_queue where waiting > ($1 || ' hours')::interval or verification = 'verified';",
        "options": {
          "queryReplacement": "={{ [String($('Config').first().json.cfg.reviewSlaHours)] }}"
        }
      },
      "id": "a0ae79b6-5226-4ae7-8a53-7df5f6edb382",
