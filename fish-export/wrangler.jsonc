{
  // GoodBuy Foods Global static site on a Cloudflare Worker with static assets.
  // Deploy from this folder: npx wrangler deploy
  // Cloudflare Workers Builds: root directory "fish-export", build command empty, deploy command "npx wrangler deploy".
  "name": "food-export",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "goodbuyfoods.com", "custom_domain": true },
    { "pattern": "www.goodbuyfoods.com", "custom_domain": true }
  ]
}
